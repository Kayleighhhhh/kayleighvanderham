<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Portfolio of Kayleigh van der Ham.">

  <title>Kayleigh van der Ham</title>

  <style>
    
    @font-face {
      font-family: Playfair;
      src: url('/assets/fonts/PlayfairDisplay-VariableFont_wght.ttf');
      font-weight: 400 900;
      font-display: swap;
    }

    @font-face {
      font-family: Inter;
      src: url('/assets/fonts/Inter-VariableFont_opsz,wght.ttf');
      font-weight: 100 900;
      font-display: swap;
    }

    :root {
      --bg: #FEF9F6;
      --bg-warm: antiquewhite;
      --ink: #3b2f2a;
      --accent: #a0522d;
      --accent-dark: #7d3f22;
      --shadow: burlywood;
      --content-width: 60rem;
    }

    *,
    *::before,
    *::after {
      box-sizing: border-box;
    }

    body {
      container-type: inline-size;
      container-name: page;
      margin: 0;
      background-color: var(--bg);
      color: var(--ink);
      font-family: Inter, system-ui, sans-serif;
      line-height: 1.6;
    }

    h1,
    h2,
    h3 {
      font-family: Playfair, Georgia, serif;
      line-height: 1.2;
    }

    a:focus-visible {
      outline: 3px solid var(--accent-dark);
      outline-offset: 3px;
    }

    header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      padding: 3rem 2rem;
      text-align: center;
    }

    header h1 {
      margin: 0;
      font-size: clamp(3rem, 13cqi, 6.5rem);
      letter-spacing: 0.02em;
    }

    header h1 span {
      display: inline-block;
    }

    header img {
      display: block;
      max-width: 100%;
      height: auto;
    }

    header h2 {
      margin: 0;
      font-family: Inter, system-ui, sans-serif;
      font-size: clamp(1.1rem, 3cqi, 1.5rem);
      font-weight: 400;
    }

    section {
      padding: 3rem max(1.5rem, calc((100% - var(--content-width)) / 2));
    }

    section h2 {
      margin: 0 0 1.5rem;
      font-size: clamp(1.8rem, 5cqi, 2.5rem);
    }

    .about,
    .projects {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      background-color: var(--bg-warm);
    }

    .about h2,
    .projects h2 {
      grid-column: 1 / -1;
      margin: 0;
    }

    .about article,
    .projects article {
      padding: 1.5rem;
      border-radius: 20px;
      background-color: var(--bg);
      box-shadow: 0 0 5px 0 var(--shadow);
    }

    article h3 {
      margin: 0 0 0.5rem;
      font-size: 1.35rem;
    }

    article p {
      margin: 0;
    }

    .skills ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .skills li {
      padding: 0.4rem 1.25rem;
      border-radius: 999px;
      background-color: var(--bg-warm);
      box-shadow: 0 0 5px 0 var(--shadow);
    }

    .skills li p {
      margin: 0;
      font-weight: 500;
    }

    .projects article {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .projects article h3 {
      margin: 0;
    }

    .projects a,
    .contact a {
      margin-top: auto;
      align-self: flex-start;
      padding: 0.5rem 1.25rem;
      border-radius: 999px;
      background-color: var(--accent);
      color: #fff;
      font-weight: 500;
      text-decoration: none;
    }

    .projects a:hover,
    .contact a:hover {
      background-color: var(--accent-dark);
    }

    .contact p {
      margin: 0 0 1.5rem;
    }

    .contact ul {
      display: flex;
      flex-wrap: wrap;
      gap: 0.76rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    @container page (min-width: 36rem) {
      .projects {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @container page (min-width: 48rem) {
      .about {
        grid-template-columns: repeat(3, 1fr);
      }
    }

    @media (prefers-reduced-motion: no-preference) {
      header h1 span {
        transition: transform 0.2s ease;
      }

      header h1 span:hover {
        transform: translateY(-0.08em) rotate(-4deg);
      }

      .projects article {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .projects article:hover {
        transform: translateY(-3px);
        box-shadow: 0 4px 12px 0 var(--shadow);
      }
    }
  </style>

</head>
<body>
